//==================== UTIL ====================//

string exec(const string& cmd) {
    array<char, 256> buffer;
    string result;

    unique_ptr<FILE, decltype(&pclose)> pipe(popen(cmd.c_str(), "r"), pclose);
    if (!pipe) return "";

    while (fgets(buffer.data(), buffer.size(), pipe.get()) != nullptr) {
        result += buffer.data();
    }

    return result;
}

double extractValue(const string& response, const string& key) {
    size_t pos = response.find(key);
    if (pos == string::npos) return -1;

    pos += key.length();

    char* endPtr;
    double val = strtod(response.c_str() + pos, &endPtr);

    return (endPtr == response.c_str() + pos) ? -1 : val;
}

double extractPrice(const string& response) {
    return extractValue(response, "\"regularMarketPrice\":");
}

double getResponse(const string& symbol, string& response) {
    static const string base =
        "curl -s --connect-timeout 2 \"https://query1.finance.yahoo.com/v7/finance/quote?symbols=";

    response = exec(base + symbol + "\"");
    return response.empty() ? -1 : 0;
}

//==================== INDICATORS ====================//

class RollingSMA {
    int period;
    double sum = 0.0;
    deque<double> window;

public:
    RollingSMA(int p) : period(p) {}

    double update(double val) {
        window.push_back(val);
        sum += val;

        if (window.size() > period) {
            sum -= window.front();
            window.pop_front();
        }

        return (window.size() == period) ? sum / period : 0.0;
    }
};

class ATR {
    int period;
    double atr = 0.0;
    int count = 0;
    bool initialized = false;

public:
    ATR(int p) : period(p) {}

    double update(double high, double low, double prevClose) {
        double tr = max({
            high - low,
            abs(high - prevClose),
            abs(low - prevClose)
        });

        if (!initialized) {
            atr += tr;
            count++;

            if (count == period) {
                atr /= period;
                initialized = true;
            }

            return atr;
        }

        atr = (atr * (period - 1) + tr) / period;
        return atr;
    }
};

//==================== FEATURE SYSTEM ====================//

enum MarketRegime {
    TRENDING,
    RANGING
};

struct FeatureConfig {
    bool useATR = true;
    bool useRegime = true;

    int atrPeriod = 14;

    double minTrendStrength = 0.002; // MA separation
    double minATR = 0.001;           // volatility threshold
};

struct FeatureState {
    double atr = 0.0;
    MarketRegime regime = RANGING;
};

class FeatureEngine {
    FeatureConfig config;
    ATR atrCalc;

public:
    FeatureEngine(const FeatureConfig& cfg)
        : config(cfg),
          atrCalc(cfg.atrPeriod) {}

    FeatureState update(double prevPrice,
                        double price,
                        double fastMA,
                        double slowMA) {

        FeatureState state;

        // ATR (approximation since no OHLC)
        if (config.useATR && prevPrice > 0) {
            double high = price;
            double low = price;
            state.atr = atrCalc.update(high, low, prevPrice);
        }

        // Regime detection
        if (config.useRegime) {
            double trendStrength = abs(fastMA - slowMA) / price;

            bool trending =
                trendStrength > config.minTrendStrength &&
                state.atr > config.minATR;

            state.regime = trending ? TRENDING : RANGING;
        }

        return state;
    }

    const FeatureConfig& getConfig() const { return config; }
};

//==================== STRATEGY ====================//

double momentum(const deque<double>& data, int lookback) {
    if (data.size() < lookback + 1) return 0.0;
    return (data.back() - data[data.size() - 1 - lookback]) /
           data[data.size() - 1 - lookback];
}

//==================== MAIN ====================//

int main() {
    const string symbol = "AMZN";

    double cash = 10000.0;
    double shares = 0.0;
    double entry = 0.0;

    double maxEquity = cash;

    const double riskPerTrade = 0.01;
    const double maxDrawdown = 0.10;
    const int cooldownSec = 10;

    RollingSMA fastMA(5);
    RollingSMA slowMA(20);

    FeatureConfig config;
    FeatureEngine features(config);

    deque<double> prices;

    double prevPrice = 0.0;
    auto lastTradeTime = chrono::steady_clock::now();

    cout << "=== LIVE TRADING SIM (ATR + REGIME) ===\n";

    int tick = 0;

    while (true) {
        string response;
        if (getResponse(symbol, response) < 0) {
            this_thread::sleep_for(chrono::seconds(2));
            continue;
        }

        double price = extractPrice(response);
        if (price <= 0) {
            this_thread::sleep_for(chrono::seconds(2));
            continue;
        }

        prices.push_back(price);
        if (prices.size() > 50)
            prices.pop_front();

        double fma = fastMA.update(price);
        double smaSlow = slowMA.update(price);
        double mom = momentum(prices, 5);

        FeatureState fs = features.update(prevPrice, price, fma, smaSlow);

        prevPrice = price;

        double equity = cash + shares * price;
        maxEquity = max(maxEquity, equity);

        if ((maxEquity - equity) / maxEquity > maxDrawdown) {
            cout << "MAX DRAWDOWN HIT. STOPPING.\n";
            break;
        }

        auto now = chrono::steady_clock::now();
        bool cooldownPassed = (now - lastTradeTime) > chrono::seconds(cooldownSec);

        bool trendUp = fma > smaSlow;
        bool trendDown = fma < smaSlow;
        bool momentumUp = mom > 0.001;

        bool allowTrading = !config.useRegime ||
                            (fs.regime == TRENDING);

        //==================== ENTRY ====================//
        if (shares == 0.0 && cooldownPassed &&
            trendUp && momentumUp && allowTrading) {

            double stopDistance = fs.atr * 2.0;
            if (stopDistance <= 0) continue;

            double riskAmount = equity * riskPerTrade;
            double newShares = riskAmount / stopDistance;

            newShares = min(newShares, cash / price);
            newShares = min(newShares, 100.0);

            if (newShares > 0) {
                shares = newShares;
                cash -= shares * price;
                entry = price;
                lastTradeTime = now;

                cout << "BUY @ " << price
                     << " | ATR: " << fs.atr
                     << " | Regime: TREND\n";
            }
        }

        //==================== EXIT ====================//
        else if (shares > 0.0) {
            double stopLoss = entry - (fs.atr * 2.0);
            double takeProfit = entry + (fs.atr * 4.0);

            if (price >= takeProfit) {
                cash += shares * price;
                shares = 0.0;
                lastTradeTime = now;

                cout << "TAKE PROFIT @ " << price << "\n";
            }
            else if (price <= stopLoss || trendDown) {
                cash += shares * price;
                shares = 0.0;
                lastTradeTime = now;

                cout << "EXIT @ " << price << "\n";
            }
        }

        equity = cash + shares * price;

        if (tick % 3 == 0) {
            cout << "Price: " << price
                 << " | ATR: " << fs.atr
                 << " | Regime: " << (fs.regime == TRENDING ? "TREND" : "RANGE")
                 << " | FastMA: " << fma
                 << " | SlowMA: " << smaSlow << "\n";

            cout << "Cash: " << cash
                 << " | Equity: " << equity << "\n\n";
        }

        tick++;
        this_thread::sleep_for(chrono::seconds(5));
    }

    return 0;
}