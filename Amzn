//==================== UTIL ====================//

string exec(const string& cmd) {
    array<char, 256> buffer;
    string result;

    unique_ptr<FILE, decltype(&pclose)> pipe(popen(cmd.c_str(), "r"), pclose);
    if (!pipe) return "";

    while (fgets(buffer.data(), buffer.size(), pipe.get()) != nullptr) {
        result += buffer.data();
    }

    return result;
}

double extractPrice(const string& response) {
    const string key = "\"regularMarketPrice\":";
    size_t pos = response.find(key);

    if (pos == string::npos) return -1;

    pos += key.length();

    char* endPtr;
    double price = strtod(response.c_str() + pos, &endPtr);

    return (endPtr == response.c_str() + pos) ? -1 : price;
}

double getPrice(const string& symbol) {
    static const string base =
        "curl -s --connect-timeout 2 \"https://query1.finance.yahoo.com/v7/finance/quote?symbols=";

    string response = exec(base + symbol + "\"");
    if (response.empty()) return -1;

    return extractPrice(response);
}

//==================== INDICATORS ====================//

class RollingSMA {
    int period;
    double sum = 0.0;
    deque<double> window;

public:
    RollingSMA(int p) : period(p) {}

    double update(double price) {
        window.push_back(price);
        sum += price;

        if (window.size() > period) {
            sum -= window.front();
            window.pop_front();
        }

        return (window.size() == period) ? sum / period : 0.0;
    }
};

class RollingVolatility {
    deque<double> returns;
    int period;

public:
    RollingVolatility(int p) : period(p) {}

    double update(double prev, double curr) {
        double r = (curr - prev) / prev;
        returns.push_back(abs(r));

        if (returns.size() > period)
            returns.pop_front();

        double sum = 0.0;
        for (double x : returns) sum += x;

        return returns.empty() ? 0.0 : sum / returns.size();
    }
};

double momentum(const deque<double>& data, int lookback) {
    if (data.size() < lookback + 1) return 0.0;
    return (data.back() - data[data.size() - 1 - lookback]) /
           data[data.size() - 1 - lookback];
}

//==================== MAIN ====================//

int main() {
    const string symbol = "AMZN";

    double cash = 10000.0;
    double shares = 0.0;
    double entry = 0.0;

    double maxEquity = cash;

    const double riskPerTrade = 0.01;
    const double maxDrawdown = 0.10;
    const int cooldownSec = 10;

    RollingSMA fastMA(5);
    RollingSMA slowMA(20);
    RollingVolatility volCalc(20);

    deque<double> prices;

    double prevPrice = 0.0;

    auto lastTradeTime = chrono::steady_clock::now();

    cout << "=== LIVE TRADING SIM (OPTIMIZED) ===\n";

    int tick = 0;

    while (true) {
        double price = getPrice(symbol);

        if (price <= 0) {
            this_thread::sleep_for(chrono::seconds(2));
            continue;
        }

        prices.push_back(price);
        if (prices.size() > 50)
            prices.pop_front();

        double fma = fastMA.update(price);
        double smaSlow = slowMA.update(price);
        double mom = momentum(prices, 5);

        double vol = (prevPrice > 0)
            ? volCalc.update(prevPrice, price)
            : 0.0;

        prevPrice = price;

        double equity = cash + shares * price;
        maxEquity = max(maxEquity, equity);

        // Drawdown protection
        if ((maxEquity - equity) / maxEquity > maxDrawdown) {
            cout << "MAX DRAWDOWN HIT. STOPPING.\n";
            break;
        }

        auto now = chrono::steady_clock::now();
        bool cooldownPassed = (now - lastTradeTime) > chrono::seconds(cooldownSec);

        double stopLossPct = max(0.005, vol * 2.0);

        //==================== ENTRY ====================//
        bool trendUp = fma > smaSlow;
        bool momentumUp = mom > 0.001;

        if (shares == 0.0 && cooldownPassed && trendUp && momentumUp) {
            double riskAmount = equity * riskPerTrade;
            double stopDistance = price * stopLossPct;

            double newShares = riskAmount / stopDistance;

            // clamp position size
            newShares = min(newShares, cash / price);
            newShares = min(newShares, 100.0); // hard cap

            if (newShares > 0) {
                shares = newShares;
                cash -= shares * price;
                entry = price;
                lastTradeTime = now;

                cout << "BUY @ " << price
                     << " | Shares: " << shares
                     << " | SL%: " << stopLossPct << "\n";
            }
        }

        //==================== EXIT ====================//
        else if (shares > 0.0) {
            double stopLoss = entry * (1.0 - stopLossPct);
            double takeProfit = entry * (1.0 + stopLossPct * 2.0);

            bool trendDown = fma < smaSlow;

            if (price >= takeProfit) {
                cash += shares * price;
                shares = 0.0;
                lastTradeTime = now;

                cout << "TAKE PROFIT @ " << price << "\n";
            }
            else if (price <= stopLoss || trendDown) {
                cash += shares * price;
                shares = 0.0;
                lastTradeTime = now;

                cout << "EXIT (SL/Trend) @ " << price << "\n";
            }
        }

        equity = cash + shares * price;

        // reduce console spam
        if (tick % 3 == 0) {
            cout << "Price: " << price
                 << " | FastMA: " << fma
                 << " | SlowMA: " << smaSlow
                 << " | Mom: " << mom
                 << " | Vol: " << vol << "\n";

            cout << "Cash: " << cash
                 << " | Equity: " << equity << "\n\n";
        }

        tick++;

        this_thread::sleep_for(chrono::seconds(5));
    }

    return 0;
}